{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "deny",
      "git status": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git blame*": "allow"
    }
  },
  "external_directory": {
    "~/": "allow"
  }
}
