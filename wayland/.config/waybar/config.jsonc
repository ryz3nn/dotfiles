{
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left": [
    "niri/workspaces"
  ],

  "modules-center": [
    "clock"
    ],

    "modules-right": [
      "tray",
      "cpu",
      "memory",
      "pulseaudio"
    ],

    "niri/workspaces": {
      "format": "{index}",
      "all-outputs": true,
      "disable-scroll": true
    },

    "clock": {
      "format": "{:%d %b %Y  %H:%M}",
      "tooltip": false
    },
    "tray": {
      "icon-size": 18,
      "spacing": 10
    },

    "cpu": {
      "format": "CPU {usage}%",
      "interval": 5,
      "tooltip": false
    },

    "memory": {
      "format": "RAM {used:0.1f}G/{total:0.1f}G",
      "interval": 5,
      "tooltip": false
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 muted",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "tooltip": false
    }
}
