{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // "opencode-antigravity-auth@latest"
    "/home/derek/.local/opt/oc-antigravity/node_modules/opencode-antigravity-auth"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      "src/**": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": "allow"
  }
  "external_directory": {
    "~/": "allow"
  }
}
