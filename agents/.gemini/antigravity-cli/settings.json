{
  "agentMode": "auto",
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "agent-decides",
  "colorScheme": "light",
  "permissions": {
    "allow": [
      "command(pwd)",
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(file)",
      "command(find)",
      "command(rg)",
      "command(grep)",
      "command(which)",
      "command(type)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git branch)",
      "command(git remote)",
      "command(git rev-parse)",
      "command(git ls-files)",
      "command(agy)",
      "command(strings)"
    ],
    "deny": [
      "command(sudo)",
      "command(rm -rf)",
      "command(chmod)",
      "command(chown)",
      "write_file(.git/)",
      "write_file(src/)",
      "write_file(tests/)",
      "write_file(examples/)"
    ],
    "ask": [
      "command(git commit)",
      "command(git push)",
      "command(git reset)",
      "command(git clean)",
      "command(git checkout)",
      "command(git restore)"
    ]
  },
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "/home/derek/projects/ryz",
    "/home/derek/projects/game-dev"
  ]
}
